manifest {
  name = '{{ github_username }}/{{ repository_name }}'
  description = '{{ project_description }}'
  version = '0.1.0'
  nextflowVersion = '!>=25.00.0'
}

params {
  input = 'data/*.fa'
  outdir = 'results'
{%- if include_aws_batch %}
  ecr_container = '{{ ecr_registry }}/{{ ecr_repository }}:{{ ecr_image_tag }}'
{%- endif %}
}

process {
  cpus = 2
  memory = '4 GB'
  time = '2h'

  withLabel: low {
    cpus = 1
    memory = '2 GB'
    time = '1h'
  }

  withLabel: medium {
    cpus = 4
    memory = '8 GB'
    time = '4h'
  }

  withLabel: high {
    cpus = 8
    memory = '16 GB'
    time = '8h'
  }

  errorStrategy = 'retry'
  maxRetries = 2
  maxErrors = '-1'
}

profiles {
  local {
    process.executor = 'local'
  }

  docker {
    process.executor = 'local'
    docker.enabled = true
    apptainer.enabled = false
    conda.enabled = false
  }

  conda {
    conda.enabled = true
    process.executor = 'local'
  }

  apptainer {
    apptainer.enabled = true
    process.executor = 'local'
  }

{%- if include_aws_batch %}
  awsbatch {
    process.executor = 'awsbatch'
    process.queue = '{{ aws_batch_job_queue }}'
    process.container = params.ecr_container
    docker.enabled = true
    apptainer.enabled = false
    conda.enabled = false
    workDir = '{{ aws_batch_work_dir }}'
    aws.region = '{{ aws_region }}'
  }
{%- endif %}

  test {
    params.input = 'data/test/*.fa'
    params.outdir = 'results-test'
    process {
      cpus = 1
      memory = '1 GB'
      time = '30m'
    }
  }

  smoke {
    params.input = 'data/smoke/*.fa'
    params.outdir = 'results-smoke'
  }

  debug {
    process.echo = true
  }
}

timeline {
  enabled = true
  file = 'timeline.html'
}

report {
  enabled = true
  file = 'report.html'
}

trace {
  enabled = true
  file = 'trace.txt'
}

dag {
  enabled = true
  file = 'dag.html'
}
