profiles {
  local {
    process.executor = 'local'
  }

  docker {
    process.executor = 'local'
    docker.enabled = true
    apptainer.enabled = false
    conda.enabled = false
  }

  conda {
    conda.enabled = true
    process.executor = 'local'
  }

  apptainer {
    apptainer.enabled = true
    process.executor = 'local'
  }

{%- if include_aws_batch %}
  awsbatch {
    process.executor = 'awsbatch'
    process.queue = '{{ aws_batch_job_queue }}'
    process.container = '{{ ecr_registry }}/{{ ecr_repository }}:{{ ecr_image_tag }}'
    docker.enabled = true
    apptainer.enabled = false
    conda.enabled = false
    workDir = '{{ aws_batch_work_dir }}'
    aws.region = '{{ aws_region }}'
  }
{%- endif %}

}
