# syntax=docker/dockerfile:1
ARG WAVE_CONDA_BASE_IMAGE=mambaorg/micromamba:2.3.3

# Stage 1: Build
FROM python:{{ python_version }}-slim AS builder

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock* ./

# Install dependencies (without dev dependencies)
RUN --mount=type=cache,target=/root/.cache/uv \
        if [ -f uv.lock ]; then \
            uv sync --frozen --no-dev --no-install-project; \
        else \
            uv sync --no-dev --no-install-project; \
        fi

# Copy source code
COPY src/ src/
COPY README.md ./

# Install the project
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -f uv.lock ]; then \
      uv sync --frozen --no-dev; \
    else \
      uv sync --no-dev; \
    fi

{%- if include_nextflow and container_strategy == 'full_pipeline_image' %}

# Stage 2: Conda tools (Wave-ready base)
FROM ${WAVE_CONDA_BASE_IMAGE} AS conda_tools

USER root
WORKDIR /opt/env

# Install bioinformatics and Nextflow runtime tools with Conda/Mamba.
COPY docker/environment-nextflow.yml ./environment-nextflow.yml
RUN micromamba install -y -n base -f /opt/env/environment-nextflow.yml && \
    micromamba clean --all --yes
{%- endif %}


# Stage 2: Runtime
FROM python:{{ python_version }}-slim AS runtime

{%- if include_nextflow and container_strategy == 'full_pipeline_image' %}

RUN apt-get update && \
    apt-get install -y --no-install-recommends bash procps && \
    rm -rf /var/lib/apt/lists/*

# Bring Conda/Mamba-provisioned tooling from the wave-compatible base stage.
COPY --from=conda_tools /opt/conda /opt/conda
{%- endif %}

# Create non-root user for security
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
COPY src/ src/

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH"
{%- if include_nextflow and container_strategy == 'full_pipeline_image' %}
ENV PATH="/opt/conda/bin:${PATH}"
{%- endif %}
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
{%- if include_nextflow %}
ENV NXF_ANSI_LOG=false
{%- endif %}

{%- if include_nextflow and container_strategy == 'full_pipeline_image' %}

COPY main.nf nextflow.config ./
COPY modules/ modules/
COPY subworkflows/ subworkflows/
COPY data/ data/
{%- endif %}

# Switch to non-root user
USER appuser
{%- if include_cli %}

# Default command
ENTRYPOINT ["{{ project_slug }}"]
CMD ["--help"]
{%- elif include_nextflow and container_strategy == 'full_pipeline_image' %}

# Default command
ENTRYPOINT ["nextflow", "run", "main.nf"]
CMD ["-profile", "{{ nextflow_default_profile }}"]
{%- else %}

# Default command
CMD ["python", "-m", "{{ project_slug }}"]
{%- endif %}
