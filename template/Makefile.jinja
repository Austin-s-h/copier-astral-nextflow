.PHONY: verify fix lint format format-check type-check install test test-cov test-matrix test-matrix-cov{% if include_nextflow %} nextflow-validate nextflow-smoke{% endif %}{% if include_security_scanning %} pysentry{% endif %}{% if include_docs %} docs docs-serve{% endif %}

# Verify - check everything without making changes
verify: lint format-check type-check{% if include_nextflow %} nextflow-validate{% endif %}

# Fix - automatically fix what can be fixed
fix:
	uv run ruff check --fix .
	uv run ruff format .

# Individual targets
lint:
	uv run ruff check .

format-check:
	uv run ruff format --check .

format:
	uv run ruff format .

type-check:
	uv run ty check

# Install all dependencies
install:
	uv sync --all-groups

# Run tests
test:
	uv run pytest tests/ -v

# Run tests with coverage
test-cov:
	uv run pytest --cov --cov-report=xml --cov-report=term-missing

# Run tests across all Python versions
test-matrix:
	uv run hatch test

# Run tests with coverage across all Python versions
test-matrix-cov:
	uv run hatch test --cover

{% if include_nextflow %}
# Validate Nextflow config and lint pipeline
nextflow-validate:
	nextflow config -profile {{ nextflow_default_profile }}
	NXF_SYNTAX_PARSER=v2 nextflow lint .

# Fast smoke run using the built-in test profile
nextflow-smoke:
	nextflow run . -profile test,{{ nextflow_default_profile }} --input "data/test/*.csv" --outdir results-smoke
{% endif %}

{% if include_security_scanning %}
# Dependency vulnerability scanning
pysentry:
	uv run pysentry-rs
{% endif %}
{% if include_docs %}
# Documentation
docs:
	uv run mkdocs build

docs-serve:
	uv run mkdocs serve
{% endif %}
